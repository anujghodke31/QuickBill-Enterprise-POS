{
  "name": "quickbill",
  "version": "3.0.0",
  "private": true,
  "description": "QuickBill — AI-powered retail platform: POS, back-office and storefront.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @quickbill/api\" \"npm run dev -w @quickbill/web\"",
    "build": "npm run build -w @quickbill/api && npm run build -w @quickbill/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @quickbill/api",
    "db:seed": "npm run db:seed -w @quickbill/api",
    "db:reset": "npm run db:reset -w @quickbill/api",
    "test:e2e": "playwright test",
    "db:deploy": "npm run db:deploy -w @quickbill/api",
    "start": "npm run start -w @quickbill/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "@types/node": "^24.0.0"
  }
}
