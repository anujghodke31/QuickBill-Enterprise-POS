# Copy to apps/api/.env for local development.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres with the pgvector extension (`npm run db:up` starts one in Docker)
DATABASE_URL=postgresql://quickbill:quickbill@localhost:5432/quickbill

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32

# Browser origin allowed by CORS (the Vite dev server in development)
APP_ORIGIN=http://localhost:5173

# Claude API — powers the analytics copilot, bill scanner and forecast briefings.
# Leave empty to run without them; everything else (including semantic search) still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional: send these requests through an Anthropic-compatible gateway instead, such as
# CallMissed (put a cm_ key in ANTHROPIC_API_KEY). Gateways take bill photos but not PDFs.
# ANTHROPIC_BASE_URL=https://api.callmissed.com

# Local embedding model for semantic search (downloads ~25 MB on first use)
EMBEDDINGS_ENABLED=true
